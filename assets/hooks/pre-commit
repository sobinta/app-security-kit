#!/usr/bin/env bash
# Pre-commit guard: blocks secrets and sensitive files before they reach git history.
# Install:  cp <skill>/assets/hooks/pre-commit .git/hooks/pre-commit && chmod +x .git/hooks/pre-commit
# Bypass a false positive (rarely!):  git commit --no-verify
set -euo pipefail

# 1) gitleaks if available (best coverage)
if command -v gitleaks >/dev/null 2>&1; then
  if gitleaks help git >/dev/null 2>&1; then
    gitleaks git --staged --redact --no-banner || { echo "✋ gitleaks found secrets in staged changes"; exit 1; }
  else
    gitleaks protect --staged --redact --no-banner || { echo "✋ gitleaks found secrets in staged changes"; exit 1; }
  fi
fi

# 2) sensitive files
blocked=$(git diff --cached --name-only --diff-filter=ACMR \
  | grep -E '(^|/)\.env($|\.)|\.(pem|key|p12|pfx|ppk|keystore|jks|kdbx|tfstate|sqlite3?|db|sql|dump)$|(^|/)id_(rsa|ed25519|ecdsa)|(^|/)(credentials|service[-_]?account)[^/]*\.json$|(^|/)backup[^/]*\.(zip|tar|tgz|gz|rar|7z)$|(^|/)\.vscode/sftp\.json$' \
  | grep -vE '\.env\.(example|sample|template)$' || true)
if [ -n "$blocked" ]; then
  echo "✋ Refusing to commit sensitive files:"; echo "$blocked" | sed 's/^/   /'
  echo "   Add them to .gitignore (see assets/gitignore-security.txt) and unstage: git restore --staged <file>"
  exit 1
fi

# 3) quick secret patterns in added lines (works without gitleaks)
pattern='(sk|rk)_live_[0-9a-zA-Z]{16,}|sk-(proj|svcacct|admin)-[A-Za-z0-9_-]{20,}|sk-ant-(api|admin)[0-9]{2}-[A-Za-z0-9_-]{20,}|(AKIA|ASIA)[0-9A-Z]{16}|gh[pousr]_[A-Za-z0-9]{36,}|github_pat_[A-Za-z0-9_]{22,}|glpat-[A-Za-z0-9_-]{20,}|xox[abposr]-[A-Za-z0-9-]{10,}|whsec_[0-9a-zA-Z]{20,}|SG\.[A-Za-z0-9_-]{22}\.[A-Za-z0-9_-]{43}|sb_secret_[A-Za-z0-9_-]{20,}|-----BEGIN [A-Z ]*PRIVATE KEY-----|"type": *"service_account"|[0-9]{8,10}:AA[0-9A-Za-z_-]{33}'
if git diff --cached -U0 --no-color | grep -E '^\+' | grep -vE '^\+\+\+' | grep -qE "$pattern"; then
  echo "✋ Possible secret in staged changes:"
  git diff --cached -U0 --no-color | grep -E '^\+' | grep -vE '^\+\+\+' | grep -nE "$pattern" | sed -E 's/([A-Za-z0-9_-]{6})[A-Za-z0-9_\/+=-]{8,}/\1…(redacted)/g' | head -5
  echo "   Move it to an environment variable. If it was ever pushed anywhere: rotate it."
  exit 1
fi
exit 0
